{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/buttons/**",
              "components/cards/**",
              "components/navigation/**",
              "components/reviews/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Montserrat|Inter))/i]",
        "message": "Font not provided by the design system. Available: Montserrat, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Component1'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|width|color|title|style|key|ref|className|style|children)$/]",
        "message": "<Component1> doesn't accept that prop. Declared props: variant, size, width, color, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Component10'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|size|showValue|valueSize|style|key|ref|className|style|children)$/]",
        "message": "<Component10> doesn't accept that prop. Declared props: value, size, showValue, valueSize, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Component11'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|style|key|ref|className|style|children)$/]",
        "message": "<Component11> doesn't accept that prop. Declared props: children, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Component12'] > JSXAttribute > JSXIdentifier[name!=/^(?:network|href|style|key|ref|className|style|children)$/]",
        "message": "<Component12> doesn't accept that prop. Declared props: network, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Component13'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|count|href|style|key|ref|className|style|children)$/]",
        "message": "<Component13> doesn't accept that prop. Declared props: value, count, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Component2'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|active|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Component2> doesn't accept that prop. Declared props: children, variant, active, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Component3'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|items|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<Component3> doesn't accept that prop. Declared props: label, items, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Component4'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|color|icon|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Component4> doesn't accept that prop. Declared props: children, variant, color, icon, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Component4'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:red|blue)$/]",
        "message": "<Component4> color must be one of 'red' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Component4'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:pencil|phone|chevron-right|chevron-down|none)$/]",
        "message": "<Component4> icon must be one of 'pencil' | 'phone' | 'chevron-right' | 'chevron-down' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Component5'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|background|hover|style|key|ref|className|style|children)$/]",
        "message": "<Component5> doesn't accept that prop. Declared props: title, background, hover, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Component6'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|image|href|onClick|width|style|key|ref|className|style|children)$/]",
        "message": "<Component6> doesn't accept that prop. Declared props: title, image, href, onClick, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Component7'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|image|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Component7> doesn't accept that prop. Declared props: title, image, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Component8'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Component8> doesn't accept that prop. Declared props: children, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Component9'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|href|style|key|ref|className|style|children)$/]",
        "message": "<Component9> doesn't accept that prop. Declared props: children, variant, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Component9'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:reviewer|business|button)$/]",
        "message": "<Component9> variant must be one of 'reviewer' | 'business' | 'button'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
